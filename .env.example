# ============================================================
# RediSprint Environment Variables
# Copy this file to .env and fill in all values
# ============================================================

# ----- Groq (LLM completions) -----
# Get your key at console.groq.com
GROQ_API_KEY=gsk_...
OPENAI_COMPLETION_MODEL=llama-3.3-70b-versatile

# ----- Embeddings (local HuggingFace, no API key needed) -----
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----- Redis -----
# Get from Redis Cloud (cloud.redis.io)
REDIS_URL=redis://default:password@your-redis-host:port

# ----- Composio -----
# Sign up at composio.dev, connect Google Sheets + Jira integrations
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_USER_ID=your-composio-user-id

# ----- Google Sheets -----
# The Sheet ID shown in the UI by default (users can override in the UI)
DEMO_GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_SHEET_RANGE=Sheet1!A1:J1000

# ----- Jira -----
JIRA_PROJECT_KEY=RED
# Optional: default component to filter semantic search
JIRA_COMPONENT_DEFAULT=

# ----- Ingestion (run once to seed Redis) -----
# Path to the CSV of past Jira tickets for semantic context
TICKETS_CSV=sample_data/past_tickets.csv
# Root directory of your codebase to ingest (set to . for this project)
CODE_DIR=.
# Repo name label stored in Redis
REPO_NAME=redisprint

# ----- Web Server -----
PORT=8000
